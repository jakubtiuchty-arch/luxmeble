{
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/kuchnie", "destination": "/kuchnie.html" },
    { "source": "/szafy", "destination": "/szafy.html" },
    { "source": "/garderoby", "destination": "/garderoby.html" },
    { "source": "/lazienki", "destination": "/lazienki.html" }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/reminder",
      "schedule": "0 */4 * * *"
    }
  ]
}
