{
  "redirects": [
    {
      "source": "/:path((?!admin|api|images|_vercel|sitemap\\.xml|robots\\.txt|favicon\\.ico|.*\\.(js|css|jpg|jpeg|png|gif|svg|webp|mp4|pdf)).*)",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/reminder",
      "schedule": "0 */4 * * *"
    }
  ]
}
