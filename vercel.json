{
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/kuchnie-trzebnica", "destination": "/kuchnie-trzebnica.html" },
    { "source": "/szafy-trzebnica", "destination": "/szafy-trzebnica.html" },
    { "source": "/garderoby-trzebnica", "destination": "/garderoby-trzebnica.html" },
    { "source": "/lazienki-trzebnica", "destination": "/lazienki-trzebnica.html" }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/reminder",
      "schedule": "0 */4 * * *"
    }
  ]
}
